# PayPilot AI Environment Configuration Example

# ==============================================================================
# SERVER CONFIGURATION (apps/api/.env)
# ==============================================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# AI Provider Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
# If not provided, PayPilot AI automatically switches to its built-in
# Deterministic Heuristic Fallback Engine with transparent UI labeling.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# PayPal Sandbox Configuration
# Create a PayPal Developer Sandbox App at https://developer.paypal.com/dashboard/applications/sandbox
# If not provided, the server operates in an explicit Demo Sandbox Simulation mode.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Currency handling
# Default checkout currency for PayPal is USD. Products can be browsed in USD or INR.
# Base currency for payment transactions:
BASE_CURRENCY=USD
INR_TO_USD_RATE=0.012

# ==============================================================================
# CLIENT CONFIGURATION (apps/web/.env)
# ==============================================================================
VITE_API_URL=http://localhost:5000/api
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
